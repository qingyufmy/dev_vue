{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "id",
    "userId",
    "expiresAt",
    "targets"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$"
    },
    "userId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "targets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "symbol",
          "timeframe"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "timeframe": {
            "oneOf": [
              {
                "enum": [
                  "M1",
                  "M5",
                  "M15",
                  "M30",
                  "H1",
                  "H4",
                  "D1"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
