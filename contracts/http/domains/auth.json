{
  "paths": {
    "/auth/session": {
      "get": {
        "operationId": "getAuthCenterSession",
        "tags": [
          "Session"
        ],
        "summary": "Read the identity center session",
        "description": "Identity center host only. Uses the auth session, not an application session. Returns Cache-Control: no-store. Does not provide application permissions.",
        "security": [
          {
            "authCenterSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Identity center session",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthCenterSessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutAuthCenterSession",
        "tags": [
          "Session"
        ],
        "summary": "Revoke the current identity center session",
        "description": "Identity center host only. Requires the current auth session CSRF token and exact issuer Origin. Clears the auth cookie; does not revoke other application or Bridge sessions. A repeated request after revocation returns 401.",
        "security": [
          {
            "authCenterSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Must equal the configured identity center issuer origin."
          }
        ],
        "responses": {
          "204": {
            "description": "Current auth session revoked; empty body",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the host-only auth session cookie with Max-Age=0.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "loginAtIdentityCenter",
        "summary": "Authenticate at auth host and continue an Authorization Code + PKCE request",
        "tags": [
          "Session"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthLoginResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/session": {
      "get": {
        "operationId": "getApplicationSession",
        "summary": "Get the current Host-only application session",
        "tags": [
          "Session"
        ],
        "responses": {
          "200": {
            "description": "Current session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/session/logout": {
      "post": {
        "operationId": "logoutCurrentApplication",
        "summary": "Revoke only the current application session",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "Current application session revoked"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/session/logout-web": {
      "post": {
        "operationId": "logoutAllWebApplications",
        "summary": "Revoke auth, www, trade and admin web sessions without revoking Bridge",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "All website sessions revoked"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/session/revoke-all": {
      "post": {
        "operationId": "revokeAllSessionsAndDevices",
        "summary": "After recent authentication, revoke all website and Bridge device sessions",
        "tags": [
          "Session"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "All website and device sessions revoked"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/realtime/tickets": {
      "post": {
        "operationId": "createRealtimeTicket",
        "summary": "Create a one-time realtime connection ticket",
        "tags": [
          "Realtime"
        ],
        "description": "Sets a short-lived, one-time, HttpOnly realtime ticket cookie.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "201": {
            "description": "Realtime ticket created",
            "headers": {
              "Set-Cookie": {
                "description": "Short-lived one-time ticket restricted to /realtime/v4",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeTicketResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authCenterSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-Http-auth_session",
        "description": "Host-only identity center session. Local insecure development uses aurum_dev_auth_session. Application session cookies are not accepted."
      },
      "applicationSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-aurum_session",
        "description": "Logical placeholder. Each application uses its own Host-only session cookie name."
      }
    },
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 16,
          "maxLength": 256
        }
      }
    },
    "responses": {
      "AuthCenterProblem": {
        "description": "Identity center problem details. Current transport uses application/json. Codes include auth_session_required, auth_session_invalid, auth_csrf_invalid, auth_host_invalid and auth_service_unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "AuthorizationRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthorizationFields"
          }
        ],
        "unevaluatedProperties": false
      },
      "AuthLoginRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AuthorizationFields"
          },
          {
            "type": "object",
            "required": [
              "login",
              "password"
            ],
            "properties": {
              "login": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "writeOnly": true
              },
              "remember": {
                "type": "boolean"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "AuthLoginResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "redirect_to"
            ],
            "additionalProperties": false,
            "properties": {
              "redirect_to": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "required": [
          "user",
          "app",
          "permissions",
          "authenticated_at",
          "mfa_level",
          "csrf_token"
        ],
        "additionalProperties": false,
        "properties": {
          "user": {
            "type": "object",
            "required": [
              "id",
              "display_name",
              "avatar_url"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/components/schemas/OpaqueId"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "avatar_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri-reference"
              }
            }
          },
          "app": {
            "type": "string",
            "enum": [
              "www",
              "trade",
              "admin"
            ]
          },
          "permissions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "authenticated_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "mfa_level": {
            "type": "string",
            "enum": [
              "none",
              "otp",
              "strong"
            ]
          },
          "csrf_token": {
            "type": "string",
            "minLength": 16,
            "maxLength": 256
          }
        }
      },
      "AuthCenterSessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "user",
              "authenticated_at",
              "mfa_level",
              "csrf_token"
            ],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/Session/properties/user"
              },
              "authenticated_at": {
                "$ref": "#/components/schemas/UtcDateTime"
              },
              "mfa_level": {
                "type": "string",
                "enum": [
                  "none",
                  "otp",
                  "strong"
                ]
              },
              "csrf_token": {
                "type": "string",
                "minLength": 16,
                "maxLength": 256
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Session"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "RealtimeTicket": {
        "type": "object",
        "required": [
          "ws_url",
          "protocol",
          "expires_at",
          "capabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "ws_url": {
            "type": "string",
            "pattern": "^/realtime/v4$"
          },
          "protocol": {
            "const": "aurum.realtime.v4"
          },
          "expires_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      },
      "RealtimeTicketResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/RealtimeTicket"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "additionalProperties": false
      },
      "AuthorizationFields": {
        "type": "object",
        "required": [
          "client_id",
          "redirect_uri",
          "response_type",
          "scope",
          "state",
          "nonce",
          "code_challenge",
          "code_challenge_method"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "enum": [
              "www-web",
              "trade-web",
              "admin-web"
            ]
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri"
          },
          "response_type": {
            "const": "code"
          },
          "scope": {
            "const": "openid profile"
          },
          "state": {
            "type": "string",
            "minLength": 24,
            "maxLength": 128
          },
          "nonce": {
            "type": "string",
            "minLength": 24,
            "maxLength": 128
          },
          "code_challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "code_challenge_method": {
            "const": "S256"
          }
        }
      }
    }
  }
}
