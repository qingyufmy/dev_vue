{
  "paths": {
    "/learning/courses/{courseId}/lessons/{lessonId}/completion": {
      "put": {
        "operationId": "setLearningCompletion",
        "summary": "Set current user's explicit lesson completion marker",
        "description": "WWW session, exact Origin and CSRF required. Preserves watched time and quiz status. Same idempotency key and body replay the original receipt; stale revision returns 409. On 503 or network uncertainty retain the original key and body. Revision zero means no existing progress row; unsigned BIGINT overflow is rejected.",
        "security": [
          {
            "applicationSession": []
          }
        ],
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$"
            }
          },
          {
            "name": "lessonId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "pattern": "[^0-9a-f-]"
              }
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearningCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningCompletionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "421": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/learning/courses": {
      "get": {
        "operationId": "listLearningCourses",
        "summary": "Read migrated learning data on www host",
        "description": "WWW host only. Private no-store. Detail uses only www-web session; locked results contain no lessons, media or progress. Progress is scoped to authenticated user.",
        "security": [],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^-?[0-9]{1,10}:[1-9][0-9]{0,9}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learning data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor"
          },
          "401": {
            "description": "Invalid www session"
          },
          "404": {
            "description": "Course not published or absent"
          },
          "421": {
            "description": "Wrong application host"
          },
          "503": {
            "description": "Read unavailable"
          }
        }
      }
    },
    "/learning/courses/{id}": {
      "get": {
        "operationId": "getLearningCourse",
        "summary": "Read migrated learning data on www host",
        "description": "WWW host only. Private no-store. Detail uses only www-web session; locked results contain no lessons, media or progress. Progress is scoped to authenticated user.",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,9}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learning data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor"
          },
          "401": {
            "description": "Invalid www session"
          },
          "404": {
            "description": "Course not published or absent"
          },
          "421": {
            "description": "Wrong application host"
          },
          "503": {
            "description": "Read unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LearningCompletionRequest": {
        "type": "object",
        "required": [
          "completed",
          "expected_revision"
        ],
        "additionalProperties": false,
        "properties": {
          "completed": {
            "type": "boolean"
          },
          "expected_revision": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-3]|18446744073709551614)$",
            "not": {
              "pattern": "[^0-9]"
            },
            "description": "Exact unsigned revision text, at most 18446744073709551614."
          }
        }
      },
      "LearningCompletionResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "lesson_id",
              "completed",
              "revision",
              "updated_at",
              "replayed"
            ],
            "additionalProperties": false,
            "properties": {
              "lesson_id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "completed": {
                "type": "boolean"
              },
              "revision": {
                "type": "string",
                "maxLength": 20,
                "pattern": "^[1-9][0-9]*$",
                "not": {
                  "pattern": "[^0-9]"
                }
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "replayed": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "LearningCourse": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "category",
          "access_level",
          "updated_at",
          "sort_order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_level": {
            "enum": [
              "free",
              "logged_in",
              "plus_pro",
              "pro_only",
              null
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sort_order": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "LearningListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items",
              "next_cursor"
            ],
            "properties": {
              "items": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/components/schemas/LearningCourse"
                }
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "meta": {
            "type": "object",
            "required": [
              "request_id",
              "generated_at"
            ],
            "properties": {
              "generated_at": {
                "type": "string",
                "format": "date-time"
              },
              "request_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "LearningDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "course",
              "access",
              "lessons",
              "lessons_truncated",
              "viewer_user_id"
            ],
            "properties": {
              "viewer_user_id": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[1-9][0-9]*$"
              },
              "course": {
                "$ref": "#/components/schemas/LearningCourse"
              },
              "access": {
                "enum": [
                  "allowed",
                  "login_required",
                  "membership_required"
                ]
              },
              "lessons": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "duration_ms",
                    "progress",
                    "resources"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "duration_ms": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "progress": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "required": [
                        "watched_ms",
                        "reported_duration_ms",
                        "completed",
                        "updated_at",
                        "revision"
                      ],
                      "properties": {
                        "revision": {
                          "type": "string",
                          "maxLength": 20,
                          "pattern": "^[1-9][0-9]*$",
                          "not": {
                            "pattern": "[^0-9]"
                          }
                        },
                        "watched_ms": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "reported_duration_ms": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "completed": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "updated_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      },
                      "additionalProperties": false
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "kind",
                          "url"
                        ],
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "lessons_truncated": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "access": {
                      "enum": [
                        "login_required",
                        "membership_required"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "lessons": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          "meta": {
            "type": "object",
            "required": [
              "request_id",
              "generated_at"
            ],
            "properties": {
              "generated_at": {
                "type": "string",
                "format": "date-time"
              },
              "request_id": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  }
}
