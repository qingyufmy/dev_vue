{
  "paths": {
    "/review-cases": {
      "get": {
        "operationId": "listReviewCases",
        "summary": "List the current user's daily, monthly and manual review cases",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "daily",
                "monthly",
                "manual"
              ]
            }
          },
          {
            "name": "account_id",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Review cases",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/review-cases/{review_case_id}": {
      "get": {
        "operationId": "getReviewCase",
        "summary": "Get one evidence-linked review case",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReviewCaseId"
          }
        ],
        "responses": {
          "200": {
            "description": "Review case",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/review-cases/{review_case_id}/generations": {
      "post": {
        "operationId": "requestReviewGeneration",
        "summary": "Retry with frozen evidence or request a new evidence revision",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReviewCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode"
                ],
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "retry",
                      "refresh_evidence"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Generation queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/review-cases/{review_case_id}/versions": {
      "post": {
        "operationId": "createReviewVersion",
        "summary": "Create an immutable user-edited review version",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReviewCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "$ref": "#/components/schemas/ReviewContent"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable version created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/review-cases/{review_case_id}/confirm": {
      "post": {
        "operationId": "confirmReviewVersion",
        "summary": "Confirm exactly the current immutable review version",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReviewCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "version_id": {
                    "$ref": "#/components/schemas/OpaqueId"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/review-cases/{review_case_id}/return": {
      "post": {
        "operationId": "returnReviewCase",
        "summary": "Return a review version for changes",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ReviewCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/manual-review-candidates": {
      "get": {
        "operationId": "listManualReviewCandidates",
        "summary": "List server-attributed manual trades eligible for review",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Manual review candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualReviewCandidateListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/manual-review-cases": {
      "post": {
        "operationId": "createManualReviewCase",
        "summary": "Queue a review for frozen manual-trade evidence",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualReviewCaseInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Manual review queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewCaseDetailResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategy-memories": {
      "get": {
        "operationId": "listStrategyMemories",
        "summary": "List one memory library per accessible strategy",
        "tags": [
          "Reviews"
        ],
        "responses": {
          "200": {
            "description": "Strategy memories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyMemoryListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/strategy-memories/{memory_id}": {
      "get": {
        "operationId": "getStrategyMemory",
        "summary": "Get the current immutable strategy-memory revision",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/MemoryId"
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy memory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyMemoryDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategy-memories/{memory_id}/updates": {
      "get": {
        "operationId": "listStrategyMemoryUpdates",
        "summary": "List exact review-derived memory deltas and conflicts",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/MemoryId"
          }
        ],
        "responses": {
          "200": {
            "description": "Pending and decided memory updates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyMemoryUpdateListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/strategy-memory-updates/{update_id}/decision": {
      "post": {
        "operationId": "decideStrategyMemoryUpdate",
        "summary": "Accept, reject or revoke one review-derived memory update with CAS",
        "tags": [
          "Reviews"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/MemoryUpdateId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "additionalProperties": false,
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "accept",
                      "reject",
                      "revoke"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory decision persisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyMemoryUpdateResponse"
                }
              }
            }
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ReviewCaseId": {
        "name": "review_case_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "MemoryId": {
        "name": "memory_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      },
      "MemoryUpdateId": {
        "name": "update_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/OpaqueId"
        }
      }
    },
    "schemas": {
      "ReviewCaseSummary": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "user_id",
          "trading_account_id",
          "account_label",
          "symbol",
          "subscription_id",
          "subscription_revision",
          "analysis_strategy_id",
          "analysis_strategy_name",
          "trader_strategy_id",
          "trader_strategy_name",
          "terminal_period_start",
          "terminal_period_end",
          "terminal_timezone_offset_minutes",
          "status",
          "evidence_status",
          "evidence_revision",
          "evidence_hash",
          "current_version_id",
          "confirmed_version_id",
          "updated_at",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "daily",
              "monthly",
              "manual"
            ]
          },
          "user_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "trading_account_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "account_label": {
            "type": "string"
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "subscription_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "subscription_revision": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Revision"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_strategy_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "analysis_strategy_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "trader_strategy_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "trader_strategy_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "terminal_period_start": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "terminal_period_end": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "terminal_timezone_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "status": {
            "type": "string",
            "enum": [
              "awaiting_evidence",
              "queued",
              "running",
              "awaiting_confirmation",
              "needs_changes",
              "confirmed",
              "failed"
            ]
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "pending",
              "incomplete",
              "complete",
              "stale"
            ]
          },
          "evidence_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "evidence_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "current_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmed_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "ReviewMemoryCandidate": {
        "type": "object",
        "required": [
          "strategy_id",
          "memory_key",
          "update_kind",
          "title",
          "content",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "strategy_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "memory_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,190}$"
          },
          "update_kind": {
            "type": "string",
            "enum": [
              "short_term",
              "long_term_candidate",
              "monthly_summary",
              "platform_candidate"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "maxLength": 20000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        }
      },
      "ReviewContent": {
        "type": "object",
        "required": [
          "schema_version",
          "conclusion",
          "headline",
          "summary",
          "metrics",
          "trade_episodes",
          "roles",
          "counterexamples",
          "memory_candidates",
          "evidence_refs",
          "full_analysis_text"
        ],
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "review.v4.1"
          },
          "conclusion": {
            "type": "string",
            "enum": [
              "effective",
              "mixed",
              "ineffective",
              "insufficient_evidence",
              "manual_trade_reviewed"
            ]
          },
          "headline": {
            "type": "string",
            "maxLength": 300
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "net_profit",
              "trade_count",
              "win_rate_percent",
              "profit_factor"
            ],
            "properties": {
              "net_profit": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Decimal"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "trade_count": {
                "type": "integer",
                "minimum": 0
              },
              "win_rate_percent": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Decimal"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "profit_factor": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Decimal"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "trade_episodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "roles": {
            "type": "object",
            "required": [
              "analyst",
              "trader",
              "risk",
              "execution"
            ],
            "additionalProperties": false,
            "properties": {
              "analyst": {
                "$ref": "#/components/schemas/ReviewRoleResult"
              },
              "trader": {
                "$ref": "#/components/schemas/ReviewRoleResult"
              },
              "risk": {
                "$ref": "#/components/schemas/ReviewRoleResult"
              },
              "execution": {
                "$ref": "#/components/schemas/ReviewRoleResult"
              }
            }
          },
          "counterexamples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "memory_candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewMemoryCandidate"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          "full_analysis_text": {
            "type": "string",
            "maxLength": 500000
          }
        }
      },
      "ReviewRoleResult": {
        "type": "object",
        "required": [
          "assessment",
          "summary",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "assessment": {
            "type": "string",
            "enum": [
              "effective",
              "mixed",
              "problem",
              "insufficient_evidence",
              "not_applicable"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 5000
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        }
      },
      "ReviewVersion": {
        "type": "object",
        "required": [
          "id",
          "review_case_id",
          "version",
          "author_kind",
          "conclusion",
          "content",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "review_case_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "author_kind": {
            "type": "string",
            "enum": [
              "ai",
              "user"
            ]
          },
          "conclusion": {
            "type": "string",
            "enum": [
              "effective",
              "mixed",
              "ineffective",
              "insufficient_evidence",
              "manual_trade_reviewed"
            ]
          },
          "content": {
            "$ref": "#/components/schemas/ReviewContent"
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          }
        }
      },
      "ReviewCaseDetail": {
        "type": "object",
        "required": [
          "summary",
          "current_version",
          "sources",
          "current_job",
          "return_reason"
        ],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/ReviewCaseSummary"
          },
          "current_version": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ReviewVersion"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "current_job": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "return_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ReviewCaseListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ReviewCaseSummary"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ReviewCaseDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ReviewCaseDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ManualReviewCandidate": {
        "type": "object",
        "required": [
          "id",
          "trading_account_id",
          "account_label",
          "ticket",
          "position_id",
          "symbol",
          "side",
          "volume",
          "opened_at",
          "closed_at",
          "net_profit",
          "terminal_timezone_offset_minutes",
          "source_classification",
          "eligibility_status",
          "selection_token",
          "selection_expires_at",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "trading_account_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "account_label": {
            "type": "string"
          },
          "ticket": {
            "type": "string"
          },
          "position_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "volume": {
            "$ref": "#/components/schemas/Decimal"
          },
          "opened_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "closed_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "net_profit": {
            "$ref": "#/components/schemas/Decimal"
          },
          "terminal_timezone_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "source_classification": {
            "type": "string",
            "enum": [
              "manual",
              "system",
              "other_ea",
              "unknown"
            ]
          },
          "eligibility_status": {
            "type": "string",
            "enum": [
              "eligible",
              "incomplete",
              "already_reviewed"
            ]
          },
          "selection_token": {
            "type": "string",
            "minLength": 24
          },
          "selection_expires_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "ManualReviewCandidateListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ManualReviewCandidate"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ManualReviewCaseInput": {
        "type": "object",
        "required": [
          "candidate_ids",
          "selection_tokens",
          "strategy_id"
        ],
        "additionalProperties": false,
        "properties": {
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          "selection_tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 24
            }
          },
          "strategy_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "user_thesis": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        }
      },
      "StrategyMemorySummary": {
        "type": "object",
        "required": [
          "id",
          "strategy_id",
          "strategy_name",
          "strategy_kind",
          "owner_user_id",
          "mode",
          "status",
          "current_version",
          "pending_count",
          "updated_at",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "strategy_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "strategy_name": {
            "type": "string"
          },
          "strategy_kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "owner_user_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "off",
              "shadow",
              "active"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "revalidating",
              "retired"
            ]
          },
          "current_version": {
            "type": "integer",
            "minimum": 0
          },
          "pending_count": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "StrategyMemoryListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StrategyMemorySummary"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyMemoryDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StrategyMemorySummary"
              },
              {
                "type": "object",
                "required": [
                  "current_revision_id",
                  "content_text",
                  "content_hash",
                  "max_context_tokens"
                ],
                "properties": {
                  "current_revision_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "content_text": {
                    "type": "string"
                  },
                  "content_hash": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "max_context_tokens": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyMemoryProposal": {
        "type": "object",
        "required": [
          "memory_key",
          "title",
          "content",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "properties": {
          "memory_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,190}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "StrategyMemoryConflict": {
        "type": "object",
        "required": [
          "type",
          "prior_update_id",
          "memory_key"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "same_key_content_changed"
            ]
          },
          "prior_update_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "memory_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{2,190}$"
          }
        }
      },
      "StrategyMemoryUpdate": {
        "type": "object",
        "required": [
          "id",
          "library_id",
          "source_review_case_id",
          "source_review_version_id",
          "update_kind",
          "status",
          "expected_library_revision",
          "proposal",
          "diff_preview_text",
          "conflicts",
          "created_at",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "library_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "source_review_case_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "source_review_version_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "update_kind": {
            "type": "string",
            "enum": [
              "short_term",
              "long_term_candidate",
              "monthly_summary",
              "platform_candidate"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "collecting_evidence",
              "awaiting_confirmation",
              "accepted",
              "rejected",
              "merged",
              "superseded"
            ]
          },
          "expected_library_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "proposal": {
            "$ref": "#/components/schemas/StrategyMemoryProposal"
          },
          "diff_preview_text": {
            "type": "string"
          },
          "conflicts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StrategyMemoryConflict"
            }
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "StrategyMemoryUpdateListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StrategyMemoryUpdate"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyMemoryUpdateResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StrategyMemoryUpdate"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      }
    }
  }
