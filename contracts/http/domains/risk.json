          "equity": {
            "$ref": "#/components/schemas/Decimal"
          },
          "free_margin": {
            "$ref": "#/components/schemas/Decimal"
          },
          "margin_level_percent": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Decimal"
              },
              {
                "type": "null"
              }
            ]
          },
          "daily_loss_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "drawdown_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "open_positions": {
            "type": "integer",
            "minimum": 0
          },
          "pending_orders": {
            "type": "integer",
            "minimum": 0
          },
          "total_volume": {
            "$ref": "#/components/schemas/Decimal"
          },
          "daily_open_count": {
            "type": "integer",
            "minimum": 0
          },
          "consecutive_losses": {
            "type": "integer",
            "minimum": 0
          },
          "terminal_timezone_offset_minutes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -840,
            "maximum": 840
          },
          "clock_status": {
            "type": "string",
            "enum": [
              "calibrated",
              "observer_bootstrap",
              "stale",
              "unavailable"
            ]
          },
          "last_successful_open_at": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UtcDateTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "cooldown_until": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UtcDateTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "data_complete": {
            "type": "boolean"
          },
          "incomplete_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "observed_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "AccountRiskSummaryResponse": {
