    "/risk-decisions/{risk_decision_id}": {
      "get": {
        "operationId": "getRiskDecision",
        "summary": "Get one complete deterministic risk decision",
        "tags": [
          "Risk"
        ],
        "parameters": [
          {
            "name": "risk_decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete risk decision",
            "content": {
              "application/json": {
