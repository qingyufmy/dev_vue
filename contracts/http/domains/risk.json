            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "RISK_DAILY_LOSS_LIMIT",
                "RISK_DRAWDOWN_LIMIT",
                "RISK_DAILY_OPEN_LIMIT",
                "RISK_CONSECUTIVE_LOSS_LIMIT",
                "RISK_COOLDOWN_ACTIVE"
              ]
            }
          },
          "baseline": {
            "$ref": "#/components/schemas/ManualRiskReleaseBaseline"
          },
          "risk_state_revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "expires_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "invalidated_at": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UtcDateTime"
              },
              {
                "type": "null"
              }
            ]
          },
          "invalidation_reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
