      "RiskDecisionDetail": {
        "type": "object",
        "required": [
          "summary",
          "rules",
          "approved_actions",
          "evaluated_at",
          "policy_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/RiskDecisionSummary"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "outcome",
                "action_id",
                "details"
              ],
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "maxLength": 128
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "rejected",
                    "not_applicable"
                  ]
                },
                "action_id": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OpaqueId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "details": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "approved_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "action_id",
                "kind",
                "parameters",
                "expected_state"
              ],
              "additionalProperties": false,
              "properties": {
                "action_id": {
                  "$ref": "#/components/schemas/OpaqueId"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "market_order",
                    "pending_order",
                    "modify_position",
                    "close_position",
                    "modify_order",
                    "cancel_order"
                  ]
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": true
                },
                "expected_state": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "evaluated_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "policy_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
