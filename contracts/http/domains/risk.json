            "$ref": "#/components/schemas/Decimal"
          },
          "max_daily_loss_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_drawdown_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_open_positions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "max_pending_orders": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "max_total_volume": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_spread_points": {
            "$ref": "#/components/schemas/Decimal"
          },
          "min_open_interval_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "max_daily_open_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "consecutive_loss_limit": {
            "type": "integer",
