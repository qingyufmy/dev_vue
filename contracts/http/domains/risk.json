            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "allowed_min",
                "allowed_max",
                "locked_value",
                "user_editable"
              ],
              "properties": {
                "allowed_min": {
                  "$ref": "#/components/schemas/Decimal"
                },
                "allowed_max": {
                  "$ref": "#/components/schemas/Decimal"
