    "/risk-accounts/{account_id}/manual-release-receipt": {
      "get": {
        "operationId": "getManualRiskReleaseReceipt",
        "summary": "Confirm the exact manual release request receipt",
        "description": "Rechecks current account ownership. An unconfirmed result does not establish transaction failure and must not cause a new idempotency key. Confirmed identifies the stored operation, not current release validity.",
        "tags": [
          "Risk"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "in": "query",
            "name": "idempotency_key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact receipt or unconfirmed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualRiskReleaseReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/risk-accounts/{account_id}/policy-receipt": {
      "get": {
        "operationId": "getRiskPolicyReceipt",
        "summary": "Read the exact original policy write receipt",
        "description": "Rechecks current account ownership. An unconfirmed result does not establish transaction failure and must not cause a new idempotency key. Confirmed identifies the stored operation, not current release validity.",
        "tags": [
          "Risk"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "in": "query",
            "name": "idempotency_key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{16,128}$",
              "minLength": 16
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exact receipt or unconfirmed result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskPolicyReceiptResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
