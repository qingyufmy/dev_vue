            "type": "integer",
            "minimum": 0,
            "maximum": 2880
          },
          "trade_send_enabled": {
            "type": "boolean"
          },
          "account_kill_switch": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "max_order_volume": {
            "$ref": "#/components/schemas/Decimal"
          }
        }
      },
      "RiskPolicy": {
        "type": "object",
        "required": [
          "account_id",
          "platform_policy_version_id",
          "account_policy_version_id",
          "global_kill_switch",
          "allowed_symbols",
          "fail_closed_on_incomplete_data",
          "max_quote_age_seconds",
          "max_risk_summary_age_seconds",
          "max_decision_age_seconds",
          "max_price_deviation_percent",
          "manual_release_enabled",
          "manual_release_max_daily_loss_percent",
          "manual_release_max_drawdown_percent",
          "manual_release_max_daily_open_count",
          "manual_release_consecutive_loss_limit",
          "max_risk_per_trade_percent",
          "max_daily_loss_percent",
          "max_drawdown_percent",
          "max_open_positions",
          "max_pending_orders",
          "max_total_volume",
          "max_spread_points",
          "min_open_interval_seconds",
          "max_daily_open_count",
          "consecutive_loss_limit",
          "loss_cooldown_minutes",
          "pending_valid_minutes",
          "weekend_close_minutes",
          "trade_send_enabled",
          "account_kill_switch",
          "require_stop_loss",
          "editable_fields",
          "revision",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "platform_policy_version_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "account_policy_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "global_kill_switch": {
            "type": "boolean",
            "readOnly": true
          },
          "allowed_symbols": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "minItems": 1,
            "uniqueItems": true,
            "readOnly": true
          },
          "fail_closed_on_incomplete_data": {
            "const": true,
            "readOnly": true
          },
          "max_quote_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true
          },
          "max_risk_summary_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true
          },
          "max_decision_age_seconds": {
            "type": "integer",
            "minimum": 1,
            "readOnly": true
          },
          "max_price_deviation_percent": {
            "$ref": "#/components/schemas/Decimal",
            "readOnly": true
          },
          "manual_release_enabled": {
            "type": "boolean",
            "readOnly": true
          },
          "manual_release_max_daily_loss_percent": {
            "$ref": "#/components/schemas/Decimal",
            "readOnly": true
          },
          "manual_release_max_drawdown_percent": {
            "$ref": "#/components/schemas/Decimal",
            "readOnly": true
          },
          "manual_release_max_daily_open_count": {
            "type": "integer",
            "minimum": 0,
            "readOnly": true
          },
          "manual_release_consecutive_loss_limit": {
            "type": "integer",
            "minimum": 0,
            "readOnly": true
          },
          "max_risk_per_trade_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_daily_loss_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_drawdown_percent": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_open_positions": {
            "type": "integer",
            "minimum": 0
          },
          "max_pending_orders": {
            "type": "integer",
            "minimum": 0
          },
          "max_total_volume": {
            "$ref": "#/components/schemas/Decimal"
          },
          "max_spread_points": {
            "$ref": "#/components/schemas/Decimal"
          },
          "min_open_interval_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "max_daily_open_count": {
            "type": "integer",
            "minimum": 0
          },
          "consecutive_loss_limit": {
            "type": "integer",
            "minimum": 0
          },
          "loss_cooldown_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "pending_valid_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "weekend_close_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "trade_send_enabled": {
            "type": "boolean"
          },
          "account_kill_switch": {
            "type": "boolean"
          },
          "require_stop_loss": {
            "const": true
          },
          "editable_fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "updated_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          },
          "max_order_volume": {
            "$ref": "#/components/schemas/Decimal"
          },
