{
  "paths": {
    "/bridge/pairing-requests": {
      "post": {
        "operationId": "createBridgePairingRequest",
        "tags": [
          "Bridge"
        ],
        "summary": "Approve a ten-minute pairing code hash for the current trade user",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BridgePairingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pairing registered; no account ownership or connection quota granted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgePairingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/bridge/pairing-redemptions": {
      "post": {
        "operationId": "redeemBridgePairing",
        "tags": [
          "Bridge"
        ],
        "security": [],
        "summary": "Bind a client-generated random refresh credential to a one-use pairing code",
        "description": "The client retains the same installation ID and random credential for lost-response retries. Codes expire after ten minutes; redemption does not grant trading account ownership. Never send secrets through URLs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BridgePairingRedemption"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Credential bound, or identical redemption replayed while still valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgePairingCredentialResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "410": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/bridge/legacy-credential-exchanges": {
      "post": {
        "operationId": "exchangeLegacyBridgeCredential",
        "summary": "Rotate a valid V3 refresh credential into a V4 device refresh credential",
        "tags": [
          "Bridge"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegacyBridgeCredentialExchange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "V4 device refresh credential issued; the V3 credential remains valid for rollback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeRefreshCredentialResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/bridge/credential-revocations": {
      "post": {
        "operationId": "revokeBridgeDeviceCredential",
        "summary": "Idempotently revoke the exact V4 device refresh credential",
        "description": "The token and device binding identify the exact generation. Confirmation remains available after membership expiry or earlier revocation. Later rotated tokens, accounts, ownership and execution history are unaffected. Routes reject subsequent authorization checks; physical socket closure is asynchronous.",
        "tags": [
          "Bridge"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BridgeSessionTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The exact device credential is revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeCredentialRevocationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/bridge/session-tokens": {
      "post": {
        "operationId": "createBridgeSessionToken",
        "summary": "Exchange a V4 device refresh credential for a short-lived Bridge session token",
        "tags": [
          "Bridge"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BridgeSessionTokenRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Short-lived, one-time Bridge session token created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BridgeSessionTokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          },
          "503": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BridgeDeviceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "BridgeRefreshToken": {
        "type": "string",
        "minLength": 40,
        "maxLength": 512,
        "pattern": "^\\S+$"
      },
      "BridgePairingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code_hash"
        ],
        "properties": {
          "code_hash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of bpc_ plus base64url of 32 cryptographically random bytes, generated in browser memory."
          }
        }
      },
      "BridgePairingResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pairing_id",
              "profile_id",
              "expires_at"
            ],
            "properties": {
              "pairing_id": {
                "type": "string",
                "format": "uuid"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "BridgePairingRedemption": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairing_code",
          "installation_id",
          "refresh_token"
        ],
        "properties": {
          "pairing_code": {
            "type": "string",
            "minLength": 47,
            "maxLength": 47,
            "pattern": "^bpc_[A-Za-z0-9_-]{43}$"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "refresh_token": {
            "type": "string",
            "minLength": 68,
            "maxLength": 68,
            "pattern": "^br4_[A-Za-z0-9_-]{64}$",
            "description": "Client-generated CSPRNG 48-byte secret. Persist securely before redemption and reuse for retries."
          }
        }
      },
      "BridgePairingCredentialResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_type",
              "installation_id",
              "profile_id",
              "generation",
              "session_token_path",
              "websocket_path"
            ],
            "properties": {
              "credential_type": {
                "const": "bridge_refresh"
              },
              "installation_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "session_token_path": {
                "const": "/api/v4/bridge/session-tokens"
              },
              "websocket_path": {
                "const": "/bridge/v4/ws"
              }
            }
          }
        }
      },
      "LegacyBridgeCredentialExchange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "legacy_refresh_token",
          "installation_id",
          "profile_id",
          "source_fingerprint"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "legacy_refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "profile_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "BridgeRefreshCredential": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_type",
          "refresh_token",
          "generation",
          "session_token_path",
          "websocket_path"
        ],
        "properties": {
          "credential_type": {
            "const": "bridge_refresh"
          },
          "refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "session_token_path": {
            "const": "/api/v4/bridge/session-tokens"
          },
          "websocket_path": {
            "const": "/bridge/v4/ws"
          }
        }
      },
      "BridgeRefreshCredentialResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BridgeRefreshCredential"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "BridgeSessionTokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refresh_token",
          "installation_id",
          "profile_id"
        ],
        "properties": {
          "refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "profile_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          }
        }
      },
      "BridgeCredentialRevocationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_type",
              "installation_id",
              "profile_id",
              "generation",
              "revoked"
            ],
            "properties": {
              "credential_type": {
                "const": "bridge_revocation"
              },
              "installation_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "revoked": {
                "const": true
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "BridgeSessionToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_type",
          "access_token",
          "expires_in_seconds",
          "websocket_path"
        ],
        "properties": {
          "credential_type": {
            "const": "bridge_session"
          },
          "access_token": {
            "type": "string",
            "minLength": 40,
            "maxLength": 128
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "websocket_path": {
            "const": "/bridge/v4/ws"
          }
        }
      },
      "BridgeSessionTokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BridgeSessionToken"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      }
    }
  }
}
