  "components": {
    "schemas": {
      "BridgeDeviceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "BridgeRefreshToken": {
        "type": "string",
        "minLength": 40,
        "maxLength": 512,
        "pattern": "^\\S+$"
      },
      "BridgePairingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code_hash"
        ],
        "properties": {
          "code_hash": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of bpc_ plus base64url of 32 cryptographically random bytes, generated in browser memory."
          }
        }
      },
      "BridgePairingResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pairing_id",
              "profile_id",
              "expires_at"
            ],
            "properties": {
              "pairing_id": {
                "type": "string",
                "format": "uuid"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "BridgePairingRedemption": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pairing_code",
          "installation_id",
          "refresh_token"
        ],
        "properties": {
          "pairing_code": {
            "type": "string",
            "minLength": 47,
            "maxLength": 47,
            "pattern": "^bpc_[A-Za-z0-9_-]{43}$"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "refresh_token": {
            "type": "string",
            "minLength": 68,
            "maxLength": 68,
            "pattern": "^br4_[A-Za-z0-9_-]{64}$",
            "description": "Client-generated CSPRNG 48-byte secret. Persist securely before redemption and reuse for retries."
          }
        }
      },
      "BridgePairingCredentialResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_type",
              "installation_id",
              "profile_id",
              "generation",
              "session_token_path",
              "websocket_path"
            ],
            "properties": {
              "credential_type": {
                "const": "bridge_refresh"
              },
              "installation_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "session_token_path": {
                "const": "/api/v4/bridge/session-tokens"
              },
              "websocket_path": {
                "const": "/bridge/v4/ws"
              }
            }
          }
        }
      },
      "LegacyBridgeCredentialExchange": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "legacy_refresh_token",
          "installation_id",
          "profile_id",
          "source_fingerprint"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "legacy_refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "profile_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "BridgeRefreshCredential": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_type",
          "refresh_token",
          "generation",
          "session_token_path",
          "websocket_path"
        ],
        "properties": {
          "credential_type": {
            "const": "bridge_refresh"
          },
          "refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "session_token_path": {
            "const": "/api/v4/bridge/session-tokens"
          },
          "websocket_path": {
            "const": "/bridge/v4/ws"
          }
        }
      },
      "BridgeRefreshCredentialResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BridgeRefreshCredential"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "BridgeSessionTokenRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refresh_token",
          "installation_id",
          "profile_id"
        ],
        "properties": {
          "refresh_token": {
            "$ref": "#/components/schemas/BridgeRefreshToken"
          },
          "installation_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          },
          "profile_id": {
            "$ref": "#/components/schemas/BridgeDeviceId"
          }
        }
      },
      "BridgeCredentialRevocationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credential_type",
              "installation_id",
              "profile_id",
              "generation",
              "revoked"
            ],
            "properties": {
              "credential_type": {
                "const": "bridge_revocation"
              },
              "installation_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "profile_id": {
                "$ref": "#/components/schemas/BridgeDeviceId"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "revoked": {
                "const": true
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "BridgeSessionToken": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credential_type",
          "access_token",
          "expires_in_seconds",
          "websocket_path"
        ],
        "properties": {
          "credential_type": {
            "const": "bridge_session"
          },
          "access_token": {
            "type": "string",
            "minLength": 40,
            "maxLength": 128
          },
          "expires_in_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "websocket_path": {
            "const": "/bridge/v4/ws"
          }
        }
      },
      "BridgeSessionTokenResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/BridgeSessionToken"
          },
          "meta": {
