{
  "paths": {
    "/strategies": {
      "get": {
        "operationId": "listStrategies",
        "summary": "List strategies visible to the current user",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "analysis",
                "trader"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createStrategy",
        "summary": "Create a user-owned strategy with its first immutable draft version",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategyCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Strategy created",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategies/compile": {
      "post": {
        "operationId": "compileStrategy",
        "summary": "Validate and normalize a strategy draft without persisting it",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategyCompile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Compile result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyCompileResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategies/{strategy_id}": {
      "get": {
        "operationId": "getStrategy",
        "summary": "Get one visible strategy and its immutable version history",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy detail",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "patch": {
        "operationId": "updateStrategyMetadata",
        "summary": "Change user-owned strategy metadata with optimistic concurrency",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategyMetadataPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Metadata updated",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "428": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategies/{strategy_id}/versions": {
      "post": {
        "operationId": "createStrategyVersion",
        "summary": "Create a new immutable user-owned strategy version",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategyVersionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Version created",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "428": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategies/{strategy_id}/versions/{version_id}/publish": {
      "post": {
        "operationId": "publishStrategyVersion",
        "summary": "Publish one immutable version as the active strategy version",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Version published",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          },
          "428": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategies/{strategy_id}/retire": {
      "post": {
        "operationId": "retireStrategy",
        "summary": "Retire a user-owned strategy while preserving its audit history",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy retired",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyDetailResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          },
          "428": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategy-subscriptions": {
      "get": {
        "operationId": "listStrategySubscriptions",
        "summary": "List strategy subscriptions owned by the current user",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategySubscriptionListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createStrategySubscription",
        "summary": "Subscribe an owned trading account to active analysis and optional trader strategies",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategySubscriptionCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategySubscriptionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/strategy-subscriptions/{subscription_id}": {
      "patch": {
        "operationId": "updateStrategySubscription",
        "summary": "Change an account strategy subscription with optimistic concurrency",
        "tags": [
          "Strategies"
        ],
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            }
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StrategySubscriptionPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription updated",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategySubscriptionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "412": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "428": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StrategySummary": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scope",
          "owner_user_id",
          "name",
          "description",
          "status",
          "active_version_id",
          "revision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "platform",
              "user"
            ]
          },
          "owner_user_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "retired"
            ]
          },
          "active_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        }
      },
      "StrategyListResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/StrategySummary"
                }
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyVersion": {
        "type": "object",
        "required": [
          "id",
          "strategy_id",
          "kind",
          "version",
          "prompt_text",
          "prompt_hash",
          "config",
          "input_contract_version",
          "output_contract_version",
          "created_by_user_id",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "strategy_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "prompt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "prompt_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          },
          "input_contract_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "output_contract_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "created_by_user_id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "created_at": {
            "$ref": "#/components/schemas/UtcDateTime"
          }
        }
      },
      "StrategyDetail": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scope",
          "owner_user_id",
          "name",
          "description",
          "status",
          "active_version_id",
          "revision",
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "platform",
              "user"
            ]
          },
          "owner_user_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "retired"
            ]
          },
          "active_version_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OpaqueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StrategyVersion"
            }
          }
        }
      },
      "StrategyDetailResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StrategyDetail"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyCompile": {
        "type": "object",
        "required": [
          "kind",
          "prompt_text",
          "config"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "prompt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StrategyCompileIssue": {
        "type": "object",
        "required": [
          "level",
          "code",
          "message",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          }
        }
      },
      "StrategyCompileResult": {
        "type": "object",
        "required": [
          "valid",
          "kind",
          "prompt_hash",
          "normalized_config",
          "input_contract_version",
          "output_contract_version",
          "issues"
        ],
        "additionalProperties": false,
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "prompt_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalized_config": {
            "type": "object",
            "additionalProperties": true
          },
          "input_contract_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "output_contract_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StrategyCompileIssue"
            }
          }
        }
      },
      "StrategyCompileResponse": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/StrategyCompileResult"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "StrategyCreate": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "description",
          "prompt_text",
          "config"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "analysis",
              "trader"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "prompt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StrategyMetadataPatch": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "StrategyVersionCreate": {
        "type": "object",
        "required": [
          "prompt_text",
          "config"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "StrategySubscriptionSchedule": {
        "type": "object",
        "required": [
          "cadence_seconds",
          "receive_timezone",
          "receive_window",
          "next_due_at",
          "revision"
        ],
        "additionalProperties": false,
