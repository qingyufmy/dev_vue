{
  "name": "wall-street-skill",
  "version": "2.3.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:www": "pnpm --filter @aurum/www dev",
    "dev:trade": "pnpm --filter @aurum/trade dev",
    "dev:admin": "pnpm --filter @aurum/admin dev",
    "dev:auth": "pnpm --filter @aurum/auth dev",
    "build:frontend": "pnpm run verify:frontend-boundaries && pnpm -r --filter ./frontend/** --if-present run build",
    "typecheck:frontend": "pnpm run verify:api-types && pnpm -r --filter ./frontend/** --if-present run typecheck",
    "test:frontend": "pnpm run verify:frontend-boundaries && pnpm -r --filter ./frontend/** --if-present run test",
    "verify:frontend-boundaries": "node frontend/scripts/verify-boundaries.mjs",
    "inspect:server-boundaries": "node scripts/inspect-server-boundaries.mjs",
    "inspect:frontend-boundaries": "node scripts/inspect-frontend-boundaries.mjs",
    "generate:api-contract": "node scripts/build-api-contract.mjs",
    "verify:api-generated": "node scripts/build-api-contract.mjs --check",
    "generate:api-types": "pnpm run verify:api-generated && node scripts/generate-api-types.mjs",
    "verify:api-types": "pnpm run verify:api-generated && node scripts/generate-api-types.mjs --check",
    "inspect:api-contracts": "pnpm run verify:api-generated && pnpm run build:server:v4 && node scripts/inspect-api-contracts.mjs",
    "inspect:api-schemas": "pnpm run verify:api-generated && node scripts/inspect-api-schemas.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "build:server:v4": "tsc -p server/tsconfig.build.json",
    "start:v4:api": "node server/dist-v4/entrypoints/api-v4.js",
    "start:v4:realtime": "node server/dist-v4/entrypoints/browser-realtime.js",
    "start:v4:bridge": "node server/dist-v4/entrypoints/bridge-gateway.js",
    "start:v4:outbox": "node server/dist-v4/entrypoints/outbox-dispatcher.js",
    "start:v4:execution": "node server/dist-v4/entrypoints/worker-execution.js",
    "start:v4:scheduler": "node server/dist-v4/entrypoints/scheduler-analysis.js",
    "start:v4:analysis": "node server/dist-v4/entrypoints/worker-analysis.js",
    "start:v4:trader": "node server/dist-v4/entrypoints/worker-trader.js",
    "start:v4:risk": "node server/dist-v4/entrypoints/worker-risk.js",
    "start:v4:review": "node server/dist-v4/entrypoints/worker-review.js",
    "start:v4:history-scheduler": "node server/dist-v4/entrypoints/scheduler-trade-history.js",
    "verify:payment-schema": "node scripts/verify-payment-schema.mjs",
    "verify:v4-migration-target": "node scripts/verify-v4-migration-target.mjs",
    "verify:v4-backup": "node scripts/verify-v4-backup.mjs",
    "migrate:v4-schema": "node scripts/migrate-v4-schema.mjs",
    "upgrade:dev-vue-schema": "node scripts/upgrade-dev-vue-schema.mjs",
    "rehearse:trade-history": "node scripts/rehearse-trade-history-migration.mjs"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@ethereumjs/util": "^10.1.2",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@solana/web3.js": "^1.98.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "6.3.4",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "fastify": "5.12.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "qiniu": "^7.15.2",
    "qiniu-js": "3.4.4",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.17.6",
    "svg-captcha": "^1.4.0",
    "tronweb": "^6.4.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "ip-address": "10.4.0",
    "jayson": {
      "uuid": "11.1.1"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "ws": "$ws"
  }
}
