    "canonicalDdl": "CREATE TABLE `terminal_history_deal_provenance_v4` (\n  `id` char(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `terminal_history_deal_id` char(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `trading_account_id` bigint unsigned NOT NULL,\n  `user_id` int NOT NULL,\n  `platform` enum('mt4','mt5') COLLATE utf8mb4_unicode_ci NOT NULL,\n  `terminal_instance_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `terminal_profile_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `broker_server` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `account_login` varchar(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `connection_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `connection_epoch` bigint unsigned NOT NULL,\n  `ownership_revision` bigint unsigned NOT NULL,\n  `request_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `query_message_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `response_message_id` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `source_revision` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `source_kind` enum('terminal','local_projection') COLLATE utf8mb4_unicode_ci NOT NULL,\n  `fact_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `provenance_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `observed_at_utc` datetime(3) NOT NULL,\n  `received_at_utc` datetime(3) NOT NULL,\n  `created_at_utc` datetime(3) NOT NULL,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_history_deal_provenance_response` (`terminal_history_deal_id`,`response_message_id`),\n  KEY `idx_history_deal_provenance_identity` (`trading_account_id`,`terminal_instance_id`,`terminal_history_deal_id`),\n  KEY `fk_history_deal_provenance_user` (`user_id`),\n  CONSTRAINT `fk_history_deal_provenance_account` FOREIGN KEY (`trading_account_id`) REFERENCES `trading_accounts` (`id`),\n  CONSTRAINT `fk_history_deal_provenance_deal` FOREIGN KEY (`terminal_history_deal_id`) REFERENCES `terminal_history_deals_v4` (`id`),\n  CONSTRAINT `fk_history_deal_provenance_user` FOREIGN KEY (`user_id`) REFERENCES `users` (`id`),\n  CONSTRAINT `chk_history_deal_provenance_hashes` CHECK ((regexp_like(`fact_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c') and regexp_like(`provenance_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c'))),\n  CONSTRAINT `chk_history_deal_provenance_revisions` CHECK (((`connection_epoch` > 0) and (`ownership_revision` > 0)))\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
