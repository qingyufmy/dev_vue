    "canonicalDdl": "CREATE TABLE `history_collection_tasks_v4` (\n  `id` char(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `trading_account_id` bigint unsigned NOT NULL,\n  `status` enum('pending','running','completing','succeeded','failed') COLLATE utf8mb4_unicode_ci NOT NULL DEFAULT 'pending',\n  `range_start_utc` datetime(3) NOT NULL,\n  `range_end_utc` datetime(3) NOT NULL,\n  `attempts` int unsigned NOT NULL DEFAULT '0',\n  `lease_token` char(36) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `lease_expires_at_utc` datetime(3) DEFAULT NULL,\n  `route_json` json DEFAULT NULL,\n  `route_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `completion_json` json DEFAULT NULL,\n  `completion_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `result_receipt_id` char(36) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `error_code` varchar(128) CHARACTER SET ascii COLLATE ascii_bin DEFAULT NULL,\n  `created_at_utc` datetime(3) NOT NULL,\n  `updated_at_utc` datetime(3) NOT NULL,\n  `completed_at_utc` datetime(3) DEFAULT NULL,\n  `active_account_id` bigint unsigned GENERATED ALWAYS AS ((case when (`status` in (_utf8mb4'pending',_utf8mb4'running',_utf8mb4'completing')) then `trading_account_id` else NULL end)) STORED,\n  PRIMARY KEY (`id`),\n  UNIQUE KEY `uk_history_task_active_account` (`active_account_id`),\n  KEY `idx_history_task_recovery` (`status`,`lease_expires_at_utc`,`id`),\n  KEY `idx_history_task_account` (`trading_account_id`,`created_at_utc`,`id`),\n  KEY `fk_history_task_receipt` (`result_receipt_id`),\n  CONSTRAINT `fk_history_task_account` FOREIGN KEY (`trading_account_id`) REFERENCES `trading_accounts` (`id`),\n  CONSTRAINT `fk_history_task_receipt` FOREIGN KEY (`result_receipt_id`) REFERENCES `terminal_history_collection_receipts_v4` (`id`),\n  CONSTRAINT `chk_history_task_completion` CHECK ((((`completion_json` is null) and (`completion_sha256` is null) and (`status` in (_utf8mb4'pending',_utf8mb4'running',_utf8mb4'failed'))) or ((`completion_json` is not null) and (`completion_sha256` is not null) and regexp_like(`completion_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c') and (`status` in (_utf8mb4'completing',_utf8mb4'succeeded',_utf8mb4'failed'))))),\n  CONSTRAINT `chk_history_task_lease` CHECK ((((`status` in (_utf8mb4'running',_utf8mb4'completing')) and (`lease_token` is not null) and (`lease_expires_at_utc` is not null)) or ((`status` not in (_utf8mb4'running',_utf8mb4'completing')) and (`lease_token` is null) and (`lease_expires_at_utc` is null)))),\n  CONSTRAINT `chk_history_task_result` CHECK ((((`status` in (_utf8mb4'pending',_utf8mb4'running',_utf8mb4'completing')) and (`completed_at_utc` is null) and (`result_receipt_id` is null)) or ((`status` = _utf8mb4'succeeded') and (`completed_at_utc` is not null) and (`result_receipt_id` is not null)) or ((`status` = _utf8mb4'failed') and (`completed_at_utc` is not null) and (`result_receipt_id` is null)))),\n  CONSTRAINT `chk_history_task_route` CHECK ((((`route_json` is null) and (`route_sha256` is null) and (`status` in (_utf8mb4'pending',_utf8mb4'failed'))) or ((`route_json` is not null) and (`route_sha256` is not null) and regexp_like(`route_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c')))),\n  CONSTRAINT `chk_history_task_window` CHECK ((`range_end_utc` > `range_start_utc`))\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci",
