  "receiptDdl": "CREATE TABLE `strategy_write_receipts_v4` (\n  `actor_user_id` int NOT NULL,\n  `idempotency_key` varchar(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `action` varchar(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `request_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `resource_id` varchar(191) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `result_revision` bigint unsigned NOT NULL,\n  `result_json` json NOT NULL,\n  `result_sha256` char(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,\n  `recorded_at_utc` datetime(3) NOT NULL,\n  PRIMARY KEY (`actor_user_id`,`idempotency_key`),\n  KEY `idx_strategy_receipt_actor_time` (`actor_user_id`,`recorded_at_utc`,`idempotency_key`),\n  CONSTRAINT `fk_strategy_receipt_actor` FOREIGN KEY (`actor_user_id`) REFERENCES `users` (`id`),\n  CONSTRAINT `chk_strategy_receipt_action` CHECK ((`action` in (_utf8mb4'create_strategy',_utf8mb4'update_metadata',_utf8mb4'create_version',_utf8mb4'publish_version',_utf8mb4'retire_strategy',_utf8mb4'create_subscription',_utf8mb4'update_subscription'))),\n  CONSTRAINT `chk_strategy_receipt_hashes` CHECK ((regexp_like(`request_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c') and (not(regexp_like(`request_sha256`,_utf8mb4'[^0-9a-f]',_utf8mb4'c'))) and regexp_like(`result_sha256`,_utf8mb4'^[0-9a-f]{64}$',_utf8mb4'c') and (not(regexp_like(`result_sha256`,_utf8mb4'[^0-9a-f]',_utf8mb4'c'))))),\n  CONSTRAINT `chk_strategy_receipt_key` CHECK ((char_length(`idempotency_key`) between 16 and 128)),\n  CONSTRAINT `chk_strategy_receipt_result` CHECK ((json_type(`result_json`) = _utf8mb4'OBJECT')),\n  CONSTRAINT `chk_strategy_receipt_revision` CHECK (((`result_revision` > 0) and (`result_revision` <= 9007199254740991)))\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci",
