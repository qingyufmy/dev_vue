  "aggregateQueries": {
    "users_rows": "SELECT COUNT(*) FROM users",
    "users_lifecycle_inconsistent": "SELECT COUNT(*) FROM users WHERE deletion_status IS NULL OR deletion_status NOT IN ('active','anonymized') OR (deletion_status='active' AND deleted_at IS NOT NULL) OR (deletion_status='anonymized' AND (deleted_at IS NULL OR role IS NULL OR role<>'user' OR plan IS NULL OR plan<>'free')) OR token_version IS NULL OR token_version<0",
    "users_role_plan_unknown": "SELECT COUNT(*) FROM users WHERE role IS NULL OR role NOT IN ('user','admin') OR plan IS NULL OR plan NOT IN ('free','plus','pro')",
    "accounts_rows": "SELECT COUNT(*) FROM trading_accounts",
    "accounts_identity_duplicate_groups": "SELECT COUNT(*) FROM (SELECT LOWER(TRIM(broker_server)),login_account FROM trading_accounts GROUP BY LOWER(TRIM(broker_server)),login_account HAVING COUNT(*)>1) x",
    "intervals_missing_user_or_account": "SELECT COUNT(*) FROM mt5_account_ownership_history o LEFT JOIN users u ON u.id=o.user_id LEFT JOIN trading_accounts a ON a.id=o.trading_account_id WHERE u.id IS NULL OR a.id IS NULL",
    "multiple_open_owner_groups": "SELECT COUNT(*) FROM (SELECT broker_server_key,login_account FROM mt5_account_ownership_history WHERE ended_at IS NULL GROUP BY broker_server_key,login_account HAVING COUNT(*)>1) x",
    "bindings_missing_user_or_account": "SELECT COUNT(*) FROM mt5_account_bindings b LEFT JOIN users u ON u.id=b.current_user_id LEFT JOIN trading_accounts a ON a.id=b.current_trading_account_id WHERE u.id IS NULL OR a.id IS NULL",
    "bindings_open_interval_disagrees": "SELECT COUNT(*) FROM mt5_account_bindings b WHERE NOT EXISTS (SELECT 1 FROM mt5_account_ownership_history o WHERE o.broker_server_key=b.broker_server_key AND o.login_account=b.login_account AND o.user_id=b.current_user_id AND o.trading_account_id=b.current_trading_account_id AND o.ended_at IS NULL)",
    "ownership_exact_bytes_disagree": "SELECT COUNT(*) FROM mt5_account_ownership_history o JOIN trading_accounts a ON a.id=o.trading_account_id WHERE BINARY a.broker_server<>BINARY o.broker_server_key OR BINARY a.login_account<>BINARY o.login_account",
    "ownership_normalized_identity_disagree": "SELECT COUNT(*) FROM mt5_account_ownership_history o JOIN trading_accounts a ON a.id=o.trading_account_id WHERE UPPER(TRIM(a.broker_server))<>UPPER(TRIM(o.broker_server_key)) OR a.login_account<>o.login_account"
  },
