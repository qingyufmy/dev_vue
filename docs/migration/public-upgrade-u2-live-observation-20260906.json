  "supplementalQueries": {
    "ownership_rows": "SELECT COUNT(*) FROM mt5_account_ownership_history",
    "ownership_server_case_only": "SELECT COUNT(*) FROM mt5_account_ownership_history o JOIN trading_accounts a ON a.id=o.trading_account_id WHERE BINARY a.broker_server<>BINARY o.broker_server_key AND BINARY UPPER(a.broker_server)=BINARY UPPER(o.broker_server_key) AND BINARY a.login_account=BINARY o.login_account",
    "ownership_server_whitespace_required": "SELECT COUNT(*) FROM mt5_account_ownership_history o JOIN trading_accounts a ON a.id=o.trading_account_id WHERE BINARY UPPER(a.broker_server)<>BINARY UPPER(o.broker_server_key) AND BINARY UPPER(TRIM(a.broker_server))=BINARY UPPER(TRIM(o.broker_server_key))",
    "ownership_login_bytes_disagree": "SELECT COUNT(*) FROM mt5_account_ownership_history o JOIN trading_accounts a ON a.id=o.trading_account_id WHERE BINARY a.login_account<>BINARY o.login_account",
    "account_identity_nonascii": "SELECT COUNT(*) FROM trading_accounts WHERE LENGTH(broker_server)<>CHAR_LENGTH(broker_server) OR LENGTH(login_account)<>CHAR_LENGTH(login_account)",
    "ownership_identity_nonascii": "SELECT COUNT(*) FROM mt5_account_ownership_history WHERE LENGTH(broker_server_key)<>CHAR_LENGTH(broker_server_key) OR LENGTH(login_account)<>CHAR_LENGTH(login_account)",
    "account_server_whitespace": "SELECT COUNT(*) FROM trading_accounts WHERE BINARY broker_server<>BINARY TRIM(broker_server)",
    "duplicate_groups_different_users": "SELECT COUNT(*) FROM (SELECT UPPER(TRIM(broker_server)),login_account FROM trading_accounts GROUP BY UPPER(TRIM(broker_server)),login_account HAVING COUNT(*)>1 AND COUNT(DISTINCT user_id)>1) x"
  }
