{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnfxtrade.com/schemas/bridge/v3/command-result-ack.schema.json",
  "title": "AURUM Bridge v3 command result acknowledgement",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": [
    "v", "type", "message_id", "sent_at_utc_msc", "acked_message_id", "command_id",
    "terminal_instance_id", "account_ref", "connection_epoch", "status"
  ],
  "properties": {
    "v": { "const": 3 },
    "type": { "const": "command_result_ack" },
    "acked_message_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "command_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "terminal_instance_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "account_ref": {
      "type": "object",
      "required": ["broker_server", "login"],
      "properties": {
        "broker_server": { "type": "string", "minLength": 1, "maxLength": 128 },
        "login": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "connection_epoch": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["applied", "duplicate"] }
  },
  "additionalProperties": false
}
