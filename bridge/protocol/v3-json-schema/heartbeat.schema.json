{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnfxtrade.com/schemas/bridge/v3/heartbeat.schema.json",
  "title": "AURUM Bridge v3 heartbeat",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": ["v", "type", "message_id", "sent_at_utc_msc", "session_id", "terminals"],
  "properties": {
    "v": { "const": 3 },
    "type": { "const": "heartbeat" },
    "session_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "terminals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["terminal_instance_id", "connection_epoch", "streams"],
        "properties": {
          "terminal_instance_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
          "connection_epoch": { "type": "integer", "minimum": 1 },
          "streams": {
            "type": "object",
            "propertyNames": { "enum": ["account", "positions", "orders", "deals"] },
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "unevaluatedProperties": false
}
