{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnfxtrade.com/schemas/bridge/v3/hello-ack.schema.json",
  "title": "AURUM Bridge v3 hello acknowledgement",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "type": "object",
  "required": [
    "v", "type", "message_id", "sent_at_utc_msc", "acked_message_id",
    "session_id", "accepted_terminal_instance_ids"
  ],
  "properties": {
    "v": { "const": 3 },
    "type": { "const": "hello_ack" },
    "acked_message_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "session_id": { "type": "string", "minLength": 8, "maxLength": 128 },
    "accepted_terminal_instance_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8, "maxLength": 128 }
    }
  },
  "additionalProperties": false
}
