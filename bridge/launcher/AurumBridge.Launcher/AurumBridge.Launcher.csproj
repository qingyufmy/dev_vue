<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AURUMBridge.Launcher</AssemblyName>
    <RootNamespace>AurumBridge.Launcher</RootNamespace>
    <ApplicationIcon>..\..\assets\liangjian-bridge.ico</ApplicationIcon>
    <AssemblyTitle>量见智桥启动器</AssemblyTitle>
    <Product>量见智桥</Product>
    <Description>量见智桥启动与自动恢复程序</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\shared\BridgeInstallationRegistration.cs" Link="Installation\BridgeInstallationRegistration.cs" />
  </ItemGroup>
</Project>
