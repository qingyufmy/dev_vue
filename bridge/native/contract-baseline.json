{
  "baseline_name": "aurum-bridge-native-3.0.0-phase-0",
  "source_branch": "refactor/aurum-bridge-v3",
  "source_commit": "906b9f88faf736d285b1099b0c688277db3c0757",
  "server_protocol": {
    "version": 3,
    "schema_directory": "../protocol/v3-json-schema",
    "wire_format": "versioned-json"
  },
  "legacy_mt5_worker_protocol": {
    "version": 3,
    "wire_format": "little-endian-u32-length-prefixed-json",
    "maximum_frame_bytes": 4194304
  },
  "native_worker_ipc_protocol": {
    "version": 1,
    "wire_format": "little-endian-u32-length-prefixed-json",
    "maximum_frame_bytes": 4194304,
    "session_nonce_required": true,
    "route_fields": [
      "terminal_instance_id",
      "platform",
      "account_ref",
      "connection_epoch"
    ],
    "request_correlation_field": "request_id",
    "query_execution_separate_operation": true,
    "trade_command_params_validated_before_worker_io": true,
    "trade_command_param_actions": [
      "place_order",
      "cancel_order",
      "modify_order",
      "modify_position",
      "close_position",
      "query_execution"
    ],
    "read_only_operations": ["collect_snapshot", "quote", "query_execution"],
    "mt5_worker_capabilities": [
      "snapshot",
      "quote",
      "execute_command",
      "query_execution"
    ],
    "demo_trade_acceptance_script": "../../scripts/bridge-native/test-mt5-demo.py",
    "demo_trade_acceptance_requires_empty_symbol_position": true,
    "mt4_demo_trade_acceptance_example": "cargo run -p bridge-mt4 --example mt4_demo_acceptance --",
    "mt4_demo_trade_acceptance_requires_demo_server": true,
    "mt4_demo_trade_acceptance_requires_empty_symbol_position": true,
    "mt4_demo_trade_acceptance_verifies_cleanup": true,
    "demo_trade_management_matrix": [
      "pending_place",
      "pending_modify",
      "pending_cancel",
      "market_open",
      "position_protection_modify",
      "partial_close",
      "full_close",
      "unique_object_cleanup"
    ],
    "demo_trade_rejection_matrix": [
      "local_volume_validation",
      "broker_order_check_rejection",
      "unique_object_cleanup"
    ],
    "demo_terminal_recovery_watch_is_read_only": true,
    "terminal_session_loss_exits_worker_for_supervised_restart": true,
    "account_route_mismatch_does_not_restart_worker": true,
    "modify_order_requires_expected_state": true,
    "partial_close_requires_exact_remaining_volume": true,
    "fault_injection_unknown_results_are_not_replayed": true,
    "windows_pipe_security": {
      "dacl_scope": "current-user-sid-only",
      "reject_remote_clients": true,
      "first_pipe_instance": true,
      "random_pipe_suffix": true
    },
    "startup_environment_fields": [
      "AURUM_BRIDGE_WORKER_PIPE",
      "AURUM_BRIDGE_WORKER_NONCE",
      "AURUM_BRIDGE_WORKER_IPC_VERSION",
      "AURUM_BRIDGE_WORKER_TERMINAL_ID",
      "AURUM_BRIDGE_WORKER_PLATFORM",
      "AURUM_BRIDGE_WORKER_BROKER_SERVER",
      "AURUM_BRIDGE_WORKER_LOGIN",
      "AURUM_BRIDGE_WORKER_CONNECTION_EPOCH",
      "AURUM_BRIDGE_WORKER_TERMINAL_PATH"
    ],
    "client_registry": {
      "key": "terminal_instance_id",
      "route_fields": ["account_ref", "connection_epoch", "platform"],
      "monotonic_client_generation": true,
      "request_pre_and_post_generation_fencing": true,
      "terminal_claim_supersedes_previous_supervisor": true,
      "stale_supervisor_cannot_remove_or_replace_current_client": true
    }
  },
  "mt4_ea_protocol": {
    "wire_format": "little-endian-u32-length-prefixed-binary",
    "maximum_frame_bytes": 4194304
  },
  "launcher_arguments": [
    "--health-check",
    "--health-file",
    "--ready-file",
    "--expected-terminal",
    "--start-minimized",
    "--profile",
    "--background"
  ],
  "credential_contract": {
    "provider": "windows-dpapi-current-user",
    "entropy_utf8": "AURUM Bridge v3 refresh credential",
    "file_name": "credential.dat",
    "lock_file_name": "credential.dat.lock",
    "json_fields": ["RefreshToken", "ExpiresAtUtcMsc"],
    "minimum_refresh_token_length": 40
  },
  "profile_contract": {
    "default_profile_id": "default",
    "default_instance_id": "AURUMBridge.v3",
    "observer_directory": "profiles/{profile_id}",
    "observer_instance_id": "AURUMBridge.v3.profile.{profile_id}"
  },
  "single_instance_contract": {
    "lock_directory": "%LOCALAPPDATA%/AURUMBridge/locks",
    "lock_file": "{instance_id}.lock",
    "activation_event": "Local\\{instance_id}.activate",
    "shutdown_event": "Local\\{instance_id}.shutdown"
  },
  "logging_contract": {
    "directory": "{profile_data_directory}/logs",
    "active_file": "bridge-{utc_yyyyMMdd}.log",
    "format": "json-lines",
    "fields": ["timestamp_utc", "level", "event_name", "message"],
    "maximum_file_bytes": 5242880,
    "retained_files": 10,
    "secrets_redacted": true
  },
  "runtime_status_contract": {
    "schema_version": 1,
    "path": "{profile_data_directory}/runtime-status.json",
    "atomic_replace": true,
    "heartbeat_seconds": 5,
    "maximum_bytes": 262144,
    "phases": ["starting", "pairing_required", "connecting", "online", "degraded", "stopped"],
    "server_states": ["stopped", "pairing_required", "connecting", "connected", "reconnecting"],
    "includes_terminal_worker_collector_and_reconciliation_state": true,
    "excludes_account_login_broker_server_and_credentials": true,
    "read_only_ui_projection": true
  },
  "worker_supervision_contract": {
    "restart_delays_seconds": [1, 2, 4, 8, 10],
    "stable_run_reset_seconds": 30,
    "maximum_failure_counter": 8,
    "retry_after_counter_cap": true,
    "kill_process_tree_on_owner_exit": true
  },
  "terminal_collection_contract": {
    "streams": ["account", "positions", "orders"],
    "active_interval_milliseconds": 250,
    "idle_interval_milliseconds": 1000,
    "retry_initial_milliseconds": 500,
    "retry_max_milliseconds": 10000,
    "post_command_wake_control_available": true,
    "full_snapshot_reconciliation": true,
    "account_route_revalidated_before_projection": true,
    "worker_restart_is_retriable": true
  },
  "terminal_session_contract": {
    "manager_scope": "one-terminal-instance",
    "account_change_requires_monotonic_epoch": true,
    "replacement_order": ["stop_old_collector", "stop_old_worker", "start_new_session"],
    "invalid_replacement_preserves_current_session": true,
    "data_ready_requires_worker_and_collector_ready": true,
    "stale_control_handle_rejected": true
  },
  "terminal_binding_contract": {
    "authority": "profile_sqlite_terminal_bindings",
    "identity_fields": ["terminal_instance_id", "platform", "terminal_path", "account_ref"],
    "activation_advances_epoch_atomically": true,
    "invalid_activation_does_not_consume_epoch": true,
    "account_switch_prunes_only_stale_data_sync_state": true,
    "same_platform_path_account_replacement_is_atomic": true,
    "bindings_ordered_by_terminal_instance_id": true,
    "runtime_change_detection_fields": ["terminal_instance_id", "platform", "terminal_path", "account_ref", "connection_epoch", "updated_at_utc_msc"]
  },
  "mt5_first_provisioning_contract": {
    "fresh_profile_does_not_require_dotnet_seed_data": true,
