    "unacknowledged_uncertain_waits_for_server_ack": true,
    "worker_query_failure_remains_pending": true,
    "only_final_same_route_results_can_resolve": true,
    "uncertain_resolution_is_monotonic": true,
    "resolution_creates_new_trade_priority_outbox_message": true,
    "resolved_result_requires_new_server_ack": true,
    "periodic_service_implemented": true,
