    "loopback_process_test_covers_command_dispatch_and_result_ack": true,
    "loopback_process_test_covers_interrupted_command_reconciliation_without_replay": true,
    "loopback_process_test_covers_disconnect_reconnect": true,
    "loopback_process_test_observes_reconnecting_status": true,
    "loopback_process_test_covers_worker_termination_and_restart": true,
    "loopback_process_test_covers_nonfatal_status_write_failure": true,
    "loopback_process_test_verifies_worker_exit": true
