    "running_installations_are_prioritized": true,
    "probe_uses_packaged_python_and_mt5_worker": true,
    "probe_timeout_seconds": 15,
    "probe_output_maximum_bytes": 16384,
    "probe_output_fields": ["probe_version", "terminal_path", "account_ref"],
    "terminal_path_and_account_route_are_strictly_validated": true,
    "successful_probe_activates_sqlite_binding": true,
    "single_terminal_is_selected_automatically": true,
    "multiple_terminals_require_user_selection": true,
    "probe_is_read_only": true
  },
  "mt4_first_provisioning_contract": {
    "fresh_profile_does_not_require_dotnet_seed_data": true,
    "discovery_sources": ["running_process", "metaquotes_terminal_data_origin", "portable_installation"],
    "running_installations_are_prioritized": true,
    "single_terminal_is_selected_automatically": true,
    "multiple_terminals_require_user_selection": true,
    "expert_is_deployed_before_account_registration": true,
    "manual_expert_repair_works_without_an_account_binding": true,
    "global_registration_pipe_owner": "default_core",
