    "observer_terminal_paths_are_reserved_before_default_fallback": true,
    "paused_observer_registration_is_rejected": true,
    "account_terminal_identity_fields": ["device_namespace", "terminal_data_path", "broker_server", "login"],
    "successful_registration_activates_profile_sqlite_binding": true,
    "same_path_account_switch_replaces_the_previous_binding": true,
    "welcome_hands_the_ea_to_a_terminal_specific_reconnect_pipe": true,
    "registration_does_not_execute_trades": true
  },
  "core_bootstrap_contract": {
    "profile_paths_are_authoritative": true,
    "credential_state_loaded_from_dpapi_store": true,
    "sqlite_opened_before_terminal_preparation": true,
    "mt5_runtime_required_only_when_mt5_is_bound": true,
    "prepared_route_matches_persisted_binding": true,
    "workers_start_only_with_server_runtime": true
