      "css": ".ds-field{display:grid;gap:7px;color:var(--text-secondary);font:600 12px var(--font-ui)}.ds-field input{min-height:40px;padding:8px 10px;border:1px solid var(--border-default);border-radius:var(--radius-sm);outline:none;background:var(--bg-input);color:var(--text-primary);font:400 14px var(--font-ui);transition:border-color var(--transition-fast),box-shadow var(--transition-fast)}.ds-field input:focus-visible{border-color:var(--gold-primary);box-shadow:0 0 0 3px var(--gold-glow)}"
