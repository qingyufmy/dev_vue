      "css": ".ds-nav-active{display:flex;align-items:center;gap:12px;width:100%;min-height:40px;padding:9px 12px;border:1px solid rgba(212,175,55,.24);border-radius:var(--radius-md);background:var(--gold-glow);color:var(--gold-primary);font:700 13.5px var(--font-ui);text-align:left;cursor:pointer}.ds-nav-active:hover{border-color:var(--gold-primary)}.ds-nav-active:focus-visible{outline:2px solid var(--gold-light);outline-offset:2px}"
