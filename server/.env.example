# ==================== 数据库 ====================
# MySQL 主机地址
MYSQL_HOST=127.0.0.1
# MySQL 端口
MYSQL_PORT=3306
# MySQL 用户名
MYSQL_USER=your_user
# MySQL 密码
MYSQL_PASSWORD=your_password
# MySQL 数据库名
MYSQL_DATABASE=your_database
# MySQL 连接池大小（默认 10，高并发可调大）
# MYSQL_POOL_SIZE=10  # minimum 2; migrations reserve one advisory-lock connection

# ==================== JWT 认证 ====================
# JWT 签名密钥（必填，服务启动时校验）
JWT_SECRET=your_jwt_secret
# JWT Token 有效期（默认 7 天，支持 m/h/d/y 单位）
# JWT_EXPIRY=7d
# 桥接刷新会话采用滑动有效期；网页 JWT 仍保持上面的短期有效期
# BRIDGE_REFRESH_TTL_DAYS=90
# Keep disabled after every installed Bridge has been upgraded to one-use WS tickets.
# ALLOW_LEGACY_BRIDGE_QUERY_TOKEN=0

# ==================== 服务器 ====================
# HTTP 监听端口
PORT=3000
# 单文件上传大小上限，单位字节（默认 10MB）
# MAX_UPLOAD_SIZE=10485760
# JSON 请求体大小上限（默认 10mb）
# JSON_BODY_LIMIT=10mb

# ==================== 敏感接口限流 ====================
# 通用 API 不在应用内限流，请在 Nginx/WAF 层配置全站 CC 防护。
# 以下时间窗口仅用于登录、注册、验证码、桥接凭据和内容写入等敏感操作。
# 单位毫秒（默认 15 分钟）
# RATE_LIMIT_WINDOW_MS=900000
# 登录/注册/验证码 每窗口最大请求数（默认 20）
# AUTH_RATE_LIMIT_MAX=20
# 桥接凭据接口每窗口最大请求数（默认 240）
# BRIDGE_AUTH_RATE_LIMIT_MAX=240
# 桥接授权页面发起限流：同一 IP 10 分钟内最多 6 次
# BRIDGE_PAIR_START_RATE_LIMIT_WINDOW_MS=600000
# BRIDGE_PAIR_START_RATE_LIMIT_MAX=6
# 内容发布 每分钟最大请求数（默认 10）
# WRITE_RATE_LIMIT_MAX=10

# ==================== Redis 缓存（可选） ====================
# Redis 主机地址，不设置则禁用缓存，服务正常运行
# REDIS_HOST=127.0.0.1
# Redis 端口
# REDIS_PORT=6379
# Redis 密码
# REDIS_PASSWORD=
# Redis 数据库编号（0-15）
# REDIS_DB=0

# 周末系统仓位清理（默认开启；依赖 Redis 和 v2.3.9+ 桥接客户端）
# 北京时间周六 04:00-05:00 执行，期间暂停自动推理并禁止新增交易
# WEEKLY_SYSTEM_FLATTEN_ENABLED=true
# 同时处理的桥接账户数（默认 5，最大 20；单账户内仍逐票串行）
# WEEKLY_SYSTEM_FLATTEN_CONCURRENCY=5

# ==================== 文件上传 ====================
# 上传文件存储目录（默认 ./uploads）
# UPLOAD_DIR=./uploads

# ==================== 跨域 ====================
# 允许的跨域来源，逗号分隔。完整来源严格匹配；不带协议的域名匹配 HTTP/HTTPS、主域名及其子域名。
# 不带端口的规则只允许默认端口；IP 不扩展子域名。例如：
# CORS_ORIGINS=localhost:3000,127.0.0.1:3000,192.168.1.254,cnfxtrade.com
# 邮件中的会员续费链接根地址
# PUBLIC_SITE_URL=https://www.cnfxtrade.com

# ==================== WebSocket 桥接 ====================
# 管理员用户 ID 缓存时间，单位毫秒（默认 5 分钟）
# ADMIN_CACHE_TTL_MS=300000

# ==================== Bridge release automation ====================
# Atomic current Manifest pointer stored on the server.
# BRIDGE_RELEASE_MANIFEST_PATH=./data/bridge-release/current.json
# P-256 public key used to verify Manifest V2 and package signatures.
# BRIDGE_RELEASE_PUBLIC_KEY_PATH=./secrets/bridge-release-public.pem
# Last fully accepted 100% release used only by the one-time installer.
# BRIDGE_BOOTSTRAP_MANIFEST_PATH=./data/bridge-release/bootstrap.json
# HTTPS immutable Qiniu object URL and exact metadata for the signed V3 bootstrapper.
# All five values must be configured together; partial configuration aborts startup.
# BRIDGE_INSTALLER_URL=https://qiniu.example/bridge/bootstrapper/<sha256>/LiangjianBridgeSetup.exe
# BRIDGE_INSTALLER_RELEASE_VERSION=3.1.0
# BRIDGE_INSTALLER_BUILD_DATE=2026-07-28
# BRIDGE_INSTALLER_SIZE_BYTES=0
# BRIDGE_INSTALLER_SHA256=<64 uppercase hex characters>
# Optional exact Broker maintenance windows for automatic normal Bridge updates.
# Times use each terminal server's configured offset; quote flow must be stopped for 90+ seconds.
# BRIDGE_UPDATE_MAINTENANCE_WINDOWS_JSON=[{"platform":"mt5","broker_server":"Broker-Demo","timezone_offset_minutes":180,"start":"23:58","end":"00:12","probe_symbol":"XAUUSD"}]
# Random 32+ character bearer token shared only with the protected release runner.
# AURUM_BRIDGE_RELEASE_API_TOKEN=replace_with_a_long_random_release_token

# ==================== 图形验证码 ====================
# 验证码有效期，单位毫秒（默认 5 分钟）
# CAPTCHA_TTL_MS=300000

# ==================== AI 模型凭据加密 ====================
# AES-256-GCM 主密钥环（JSON 格式：{"1":"base64_encoded_32_byte_key",...}）
# 不同于 JWT_SECRET，用于加密存储 API Key。缺少时禁止保存新凭据。
# AI_CREDENTIAL_KEYS_JSON={"1":"your_base64_encoded_32_byte_key"}
# 当前使用的密钥版本（对应 keys_json 中的 key）
# AI_CREDENTIAL_ACTIVE_KEY_VERSION=1
# Development only. Keep false in production to require HTTPS and block model
# endpoints that resolve to localhost or private networks.
AI_ALLOW_PRIVATE_MODEL_ENDPOINTS=false
# 仅用于紧急回滚。正常运行必须保持 false，避免旧明文字段再次成为隐式凭据来源。
AI_LEGACY_CREDENTIAL_READ_ENABLED=false

# ==================== AI 推理 ====================
# LLM API 基础地址（默认 DeepSeek，可切换为 OpenAI 等兼容接口）
# DEFAULT_API_BASE_URL=https://api.deepseek.com

# ==================== 调试开关 ====================
# 缠论模块调试日志（设置为 1 开启）
# DEBUG_CHAN=1
# LLM 请求/响应调试日志（设置为 1 开启）
# DEBUG_LLM=1
# DEBUG_LLM_PAYLOAD=1
# WebSocket 握手与初始化调试日志（设置为 1 开启）
# DEBUG_BRIDGE_WS=1

# ==================== USDT 支付（HD 钱包） ====================
# 已过期支付订单保留天数（默认 30 天；只清理 status=expired，已支付订单永久保留）
# PAYMENT_EXPIRED_ORDER_RETENTION_DAYS=30
# 过期订单清理间隔，单位毫秒（默认 6 小时）
# PAYMENT_EXPIRED_ORDER_CLEANUP_INTERVAL_MS=21600000
# 每轮最多清理的订单数（默认 500，最大 5000）
# PAYMENT_EXPIRED_ORDER_CLEANUP_BATCH_SIZE=500
# 是否启用过期订单清理（默认 true）
# PAYMENT_EXPIRED_ORDER_CLEANUP_ENABLED=true
# 助记词，用于派生各链收款地址（必填，仅支持环境变量，勿存数据库）
HD_WALLET_MNEMONIC=your twelve word mnemonic phrase here
# TronGrid API Key（TRON 链查询）
TRONGRID_API_KEY=your_trongrid_api_key
# Etherscan API Key（ETH 链查询）
ETHERSCAN_API_KEY=your_etherscan_api_key
# BSCScan API Key（BSC 链查询）
BSCSCAN_API_KEY=your_bscscan_api_key
# Solana RPC 节点地址（SOL 链查询，默认公共节点）
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
